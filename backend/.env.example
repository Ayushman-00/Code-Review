# Backend environment variables
# Copy this file to .env and fill in your real values
# Never commit the actual .env file

# Required — get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional but recommended — prevents GitHub API rate limiting
# Get at: GitHub → Settings → Developer Settings → Personal Access Tokens → Tokens (classic)
# Permissions needed: public_repo (read only)
GITHUB_TOKEN=your_github_token_here
